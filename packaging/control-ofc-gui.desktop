[Desktop Entry]
# Version of the freedesktop Desktop Entry Specification this file targets —
# NOT the application version.
Version=1.0
Type=Application
Name=Control-OFC
Comment=Desktop fan control GUI for the Control-OFC daemon
Exec=control-ofc-gui
Icon=control-ofc
Terminal=false
Categories=System;Settings;Monitor;HardwareSettings;
Keywords=fan;cooling;temperature;hwmon;
StartupWMClass=control-ofc-gui
