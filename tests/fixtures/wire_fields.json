    {
      "daemon": "PwmHeaderEntry",
      "gui": "InventoryPwmControl",
      "endpoints": [
        "GET /inventory/hwmon .pwm_controls"
      ],
      "note": "The SAME daemon struct as GET /hwmon/headers. Two GUI names for one wire shape is how WIRE-h stayed invisible: HwmonHeader was kept current and InventoryPwmControl was not, while its docstring claimed a field-for-field mirror.",
      "fields": [
        "id",
        "label",
        "chip_name",
        "device_id",
        "pwm_index",
        "supports_enable",
        "rpm_available",
        "min_pwm_percent",
        "max_pwm_percent",
        "is_writable",
        "pwm_mode",
        "is_aio",
        "role",
        "role_source",
