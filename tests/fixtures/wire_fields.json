{
  "description": "The declared GUI <-> daemon wire-field surface (WIRE-aj). For each daemon Serialize struct the GUI consumes, the exact set of keys it puts on the wire and the dataclass that must model them. Pinned on the daemon side by daemon/src/api/responses.rs::tests::wire_field_surface_is_pinned, which fails if a struct's serialised key set and this list disagree; pinned on this side by tests/test_wire_field_coverage.py, which fails if a declared field has no model slot. Adding a wire field means updating the Rust test, this fixture, and docs/08.",
  "min_daemon_version": "2.35.4",
  "structs": [
    {
      "daemon": "SensorEntry",
      "gui": "SensorReading",
      "endpoints": [
        "GET /sensors",
        "GET /poll"
      ],
      "fields": [
        "id",
        "kind",
        "label",
        "value_c",
        "source",
        "age_ms",
        "rate_c_per_s",
        "session_min_c",
        "session_max_c",
        "chip_name",
        "temp_type",
        "thresholds",
        "control_eligible"
      ],
      "must_be_read": [
        "control_eligible",
        "thresholds",
        "value_c",
        "rate_c_per_s"
      ]
    },
    {
      "daemon": "FanEntry",
      "gui": "FanReading",
      "endpoints": [
        "GET /fans",
        "GET /poll"
      ],
      "fields": [
        "id",
        "source",
        "rpm",
        "last_commanded_pwm",
        "duty_pct",
        "age_ms",
        "stall_detected",
        "pwm_enable_mode",
        "fan_alarm",
        "pwm_readback_pct",
        "pwm_commanded_pct"
      ],
      "must_be_read": [
        "stall_detected",
        "pwm_readback_pct",
        "pwm_commanded_pct",
        "duty_pct"
      ]
    },
    {
